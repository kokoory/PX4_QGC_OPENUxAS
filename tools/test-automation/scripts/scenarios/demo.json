    {"wait": 3,  "action": "takeoff", "altitude": 40,   "comment": "auto takeoff to 40 m"},
    {"wait": 25, "action": "start_mission",             "comment": "begin the uploaded mission"},
    {"wait": 90, "action": "rtl",                       "comment": "return to launch"},
    {"wait": 40, "action": "land",                      "comment": "land"}
  ]
}
