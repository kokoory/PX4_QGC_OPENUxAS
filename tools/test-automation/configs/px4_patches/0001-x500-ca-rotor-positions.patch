-param set-default CA_ROTOR0_PX 0.13
-param set-default CA_ROTOR0_PY 0.22
+# Rotor positions adjusted to match the actual Gazebo x500_base SDF
+# rotor link poses: ±0.174 m on both axes (symmetric square X). The
+# original asymmetric values (±0.13, ±0.20-0.22) made PX4's CA invert
+# torque allocation against the wrong arm lengths, producing motor
+# commands that BC was learning as ground-truth despite the discrepancy.
+param set-default CA_ROTOR0_PX  0.174
+param set-default CA_ROTOR0_PY  0.174
 param set-default CA_ROTOR0_KM  0.05
 
-param set-default CA_ROTOR1_PX -0.13
-param set-default CA_ROTOR1_PY -0.20
+param set-default CA_ROTOR1_PX -0.174
