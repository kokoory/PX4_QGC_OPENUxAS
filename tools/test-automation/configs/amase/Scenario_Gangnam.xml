<?xml version="1.0" encoding="UTF-8"?>
<!--
  AMASE scenario for the Gangnam (Seoul, Korea) test area used by the
  QGC ⇆ UxAS multi-vehicle pipeline. Centered on the same point QGC's
  flight map opens on (vehicles.json defaults.home_lat/home_lon =
  37.4979, 127.0276 — Gangnam Station).

  Intentionally empty: no AirVehicleConfiguration, no AirVehicleState, no
  tasks. Vehicles and MissionCommand objects are streamed into AMASE LIVE
  over its TCP bridge (port 5555) by tools/test-automation/scripts/
  uxas_search_listener.py once UxAS plans them.

  LongExtent ~0.11 deg (~5 km half-extent at this latitude) — matches the
  default UxAS region_radius=3 km plus a little margin.

  Launch (see run_amase_goheung.sh; SCENARIO defaults here):
    SCENARIO=.../Scenario_Gangnam.xml bash run_amase_goheung.sh
-->
<AMASE>
  <ScenarioData>
    <SimulationView LongExtent="0.11" Latitude="37.4979" Longitude="127.0276"/>
    <ScenarioName>Gangnam Search Area</ScenarioName>
    <Date>1/1/2026:12:00:00</Date>
    <ScenarioDuration>7200.0</ScenarioDuration>
    <TrackAgeOut/>
  </ScenarioData>
  <ScenarioEventList/>
</AMASE>
